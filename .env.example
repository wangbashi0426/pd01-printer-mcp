# Optional. The default device name is PD01.
PD01_DEVICE_NAME=PD01

# Optional. Set this only when several printers share the same name.
# Never commit a real device address.
PD01_DEVICE_ADDRESS=

# Safe default: listen on this computer only.
MCP_HOST=127.0.0.1
MCP_PORT=4176

# Optional Windows TTF/TTC font path.
PD01_FONT_PATH=

# 8192-65535. Start conservatively to protect the print head.
PD01_PRINT_ENERGY=32768

# Optional cloud telegram queue. The PC makes outbound connections, so no
# inbound tunnel or public port is needed. Leave TELEGRAM_AUTOPRINT=0 until
# the relay URL and shared worker secret are configured.
TELEGRAM_RELAY_URL=
TELEGRAM_RELAY_ACCESS_TOKEN=
TELEGRAM_RELAY_WORKER_SECRET=
TELEGRAM_AUTOPRINT=0
TELEGRAM_POLL_SECONDS=20
TELEGRAM_DEVICE_ID=home-pd01
TELEGRAM_LEDGER_PATH=telegram_delivery.sqlite3
