# Bind to all interfaces only inside a protected container or reverse proxy.
RELAY_HOST=0.0.0.0
RELAY_PORT=4177
RELAY_DB_PATH=/data/telegram_relay.sqlite3

# Generate a long random value and use the same value on the home PC.
RELAY_WORKER_SECRET=replace-with-a-long-random-secret

# Manual prepare + confirmation remains available regardless of this setting.
# Set to 1 only after the human explicitly opts into autonomous telegrams.
ALLOW_AUTONOMOUS_TELEGRAMS=0
TELEGRAM_TIMEZONE=Asia/Shanghai
TELEGRAM_ALLOWED_START=08:00
TELEGRAM_ALLOWED_END=23:00
TELEGRAM_MAX_PER_DAY=6
TELEGRAM_MAX_CHARS=280
